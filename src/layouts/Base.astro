---
import { ClientRouter } from "astro:transitions";

import SearchDialog from "../components/react/SearchDialog";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getSearchDocuments } from "../lib/curriculum";
import { BANNER_KEY, THEME_KEY } from "../lib/keys";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Personal concept notes for the Burp Suite Certified Practitioner track and CompTIA Security+ (SY0-701 style). Lab drills stay with the coach.",
} = Astro.props;

const fullTitle = title ? `${title} · Study Desk` : "Study Desk";
const documents = getSearchDocuments();
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Jon Marien" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,650&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ themeKey: THEME_KEY, bannerKey: BANNER_KEY }}>
      (() => {
        var applySaved = (root) => {
          try {
            var stored = localStorage.getItem(themeKey);
            var dark =
              stored === "dark" ||
              (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
            root.classList.toggle("dark", dark);
            if (localStorage.getItem(bannerKey) === "dismissed") root.dataset.banner = "off";
            else delete root.dataset.banner;
          } catch (error) {
            console.error(error);
          }
        };
        applySaved(document.documentElement);
        // Client routing replaces <html> attributes with the next page, which is rendered before this choice exists.
        document.addEventListener("astro:before-swap", (event) => {
          if (event.newDocument && event.newDocument.documentElement) {
            applySaved(event.newDocument.documentElement);
          }
        });
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-card focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>
    <SiteFooter />
    <SearchDialog client:idle documents={documents} />
    <script>
      document.addEventListener("astro:page-load", () => {
        const alpine = window.Alpine;
        if (!alpine) return;
        alpine.initTree(document.body);
      });
    </script>
  </body>
</html>
