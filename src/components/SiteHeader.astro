---
import ThemeToggle from "./solid/ThemeToggle";

const links = [
  { href: "/bscp", label: "BSCP" },
  { href: "/security-plus", label: "Security+" },
  { href: "/quizzes", label: "Quizzes" },
  { href: "/labs", label: "Labs" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function active(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<header x-data class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
    <a href="/" class="mr-auto leading-tight">
      <span class="block text-[0.68rem] uppercase tracking-[0.16em] text-muted">Jon Marien</span>
      <span class="font-display text-2xl text-ink">Study Desk</span>
    </a>
    <button
      type="button"
      class="rounded-full border border-line px-3 py-1.5 text-sm sm:hidden"
      @click="$store.desk.menuOpen = !$store.desk.menuOpen"
      :aria-expanded="$store.desk.menuOpen ? 'true' : 'false'"
      aria-controls="primary-nav"
    >
      Menu
    </button>
    <nav
      id="primary-nav"
      aria-label="Primary"
      class="flex max-sm:w-full flex-wrap items-center gap-1 sm:!flex"
      x-cloak
      x-show="$store.desk.menuOpen"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={active(link.href) ? "page" : undefined}
            class:list={[
              "rounded-full px-3 py-1.5 text-sm",
              active(link.href) ? "bg-soft text-ink" : "text-muted hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      @click="$dispatch('open-search')"
      aria-keyshortcuts="/"
      class="rounded-full border border-line px-3 py-1.5 text-sm hover:border-accent"
    >
      Search
      <kbd class="ml-2 hidden rounded border border-line px-1.5 py-0.5 text-[0.7rem] text-muted sm:inline">
        /
      </kbd>
    </button>
    <ThemeToggle client:load />
  </div>
</header>
