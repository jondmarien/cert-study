---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <div class="max-w-xl">
    <p class="text-xs uppercase tracking-[0.16em] text-muted">404</p>
    <h1 class="mt-2 font-display text-5xl">That page is not on the desk</h1>
    <p class="mt-4 text-muted">The track or lesson slug does not match a note.</p>
    <a href="/" class="mt-6 inline-flex rounded-full bg-ink px-4 py-2 text-sm text-paper">Back to the desk</a>
  </div>
</Base>
