---
import HomeProgress from "../components/preact/HomeProgress";
import Base from "../layouts/Base.astro";
import { getStartLinks, getTrackLessons, loadCurriculum } from "../lib/curriculum";
import { BSCP_LICENSE_ENDS, formatLicenseDate } from "../lib/study-config";
import { TRACK_LIST } from "../lib/tracks";

const cards = TRACK_LIST.map((track) => {
  const lessons = getTrackLessons(track.id);
  const ready = lessons.filter((lesson) => lesson.status === "ready");
  return {
    id: track.id,
    title: track.title,
    shortTitle: track.shortTitle,
    eyebrow: track.eyebrow,
    summary: track.summary,
    href: track.href,
    lessonCount: lessons.length,
    readyCount: ready.length,
    readyMinutes: ready.reduce((total, lesson) => total + lesson.minutes, 0),
    slugs: lessons.map((lesson) => lesson.slug),
  };
});

const starts = TRACK_LIST.flatMap((track) =>
  getStartLinks(track.id).map((lesson) => ({
    href: lesson.href,
    title: lesson.title,
    summary: lesson.summary,
    trackTitle: track.shortTitle,
  })),
);

const knownHrefs = loadCurriculum().map((lesson) => lesson.href);
const licenseLabel = formatLicenseDate();
---

<Base>
  <study-urgency-banner ends={BSCP_LICENSE_ENDS} label={licenseLabel}>
    <aside class="rounded-2xl border border-warn bg-warn-soft px-4 py-3" aria-label="BSCP timing reminder">
      <p class="max-w-3xl text-sm leading-6 text-ink">
        <span class="font-semibold">BSCP timing. </span>
        This desk assumes Burp Suite Professional access through {licenseLabel}. The exam is a lab, so use
        authorized PortSwigger labs while these concepts are fresh. Edit the date in <code class="text-xs">src/lib/study-config.ts</code> if your license ends on another day.
      </p>
    </aside>
  </study-urgency-banner>
  <script>
    import "../components/lit/urgency-banner";
  </script>
  <section class="mt-8 max-w-3xl">
    <p class="text-xs uppercase tracking-[0.16em] text-muted">Personal cert desk</p>
    <h1 class="mt-3 font-display text-5xl leading-[0.95] sm:text-6xl">
      Learn the ideas. Drill the reps with your coach.
    </h1>
    <p class="mt-5 text-lg leading-8">
      Two tracks live here: Burp Suite Certified Practitioner and CompTIA Security+ in the SY0-701 shape.
      Read for the concept, the evidence you would compare, and the control that would have stopped it.
      Question practice stays in Drill.
    </p>
  </section>
  <div class="mt-8">
    <HomeProgress client:load cards={cards} starts={starts} knownHrefs={knownHrefs} />
  </div>
  <section class="mt-12 grid gap-4 md:grid-cols-3">
    <article class="rounded-2xl border border-line bg-card p-4">
      <h2 class="font-display text-2xl">Read, then lab</h2>
      <p class="mt-2 text-sm leading-6 text-muted">
        BSCP notes tell you what a family of bugs means and which Burp tool to reach for. The
        <a class="underline decoration-line underline-offset-4" href="/labs">Labs</a>
        section keeps the figures from the Quartz notes. The exact lab input stays in an Academy lab.
      </p>
    </article>
    <article class="rounded-2xl border border-line bg-card p-4">
      <h2 class="font-display text-2xl">No question bank</h2>
      <p class="mt-2 text-sm leading-6 text-muted">
        Security+ notes are short distinctions, not practice items. If a page says Outline, the write-up
        is still a checklist.
      </p>
    </article>
    <article class="rounded-2xl border border-line bg-card p-4">
      <h2 class="font-display text-2xl">Progress stays local</h2>
      <p class="mt-2 text-sm leading-6 text-muted">
        Mark a note not started, in progress, or done. That record lives in this browser. Press / to
        search both tracks.
      </p>
    </article>
  </section>
</Base>
