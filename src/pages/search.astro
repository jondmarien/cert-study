---
import { SearchPanel } from "../components/react/SearchPanel";
import Base from "../layouts/Base.astro";
import { getSearchDocuments } from "../lib/curriculum";

const initialQuery = Astro.url.searchParams.get("q") ?? "";
const documents = getSearchDocuments();
---

<Base title="Search" description="Search BSCP and Security+ study notes.">
  <div class="max-w-2xl">
    <p class="text-xs uppercase tracking-[0.16em] text-muted">Both tracks</p>
    <h1 class="mt-2 font-display text-5xl">Search</h1>
    <p class="mt-3 text-muted">
      Look across both tracks. The same search opens from the header with / or Ctrl/Cmd+K.
    </p>
    <div class="mt-6">
      <SearchPanel client:load documents={documents} initialQuery={initialQuery} />
    </div>
  </div>
</Base>
