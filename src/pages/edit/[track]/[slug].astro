---
import fs from "node:fs";

import LessonEditor from "../../../components/react/LessonEditor";
import Base from "../../../layouts/Base.astro";
import { loadCurriculum, resolveLessonFile } from "../../../lib/curriculum";

export function getStaticPaths() {
  if (import.meta.env.DEV !== true) return [];
  return loadCurriculum().map((lesson) => ({
    params: { track: lesson.track, slug: lesson.slug },
  }));
}

const track = Astro.params.track ?? "";
const slug = Astro.params.slug ?? "";
const file = resolveLessonFile(track, slug);
if (!import.meta.env.DEV || !file) {
  throw new Error(`Content error: edit route is only available in dev (${track}/${slug})`);
}

if (!fs.existsSync(file)) {
  throw new Error(`Content error: missing content/${track}/${slug}.mdx`);
}
const source = fs.readFileSync(file, "utf8");
---

<Base title={`Edit ${slug}`} description="Edit this lesson file while the dev server is running.">
  <LessonEditor client:load track={track} slug={slug} source={source} />
</Base>
